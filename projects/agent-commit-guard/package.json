{
  "name": "agent-commit-guard",
  "version": "0.3.0",
  "description": "Keep the secrets your AI coding agent saves out of git: Claude Code \"don't ask again\" allowlists (.claude/settings.local.json), MCP configs, agent files. Agent hook + pre-commit guard + auto-fix.",
  "type": "module",
  "bin": {
    "agent-commit-guard": "bin/agent-commit-guard.js"
  },
  "main": "src/scan.js",
  "exports": {
    ".": "./src/scan.js",
    "./detect": "./src/detect.js"
  },
  "files": [
    "bin",
    "src",
    "action.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "claude-code",
    "settings.local.json",
    "secrets",
    "secret-scanning",
    "security",
    "mcp",
    "ai-agents",
    "coding-agent",
    "cursor",
    "codex",
    "gemini-cli",
    "pre-commit",
    "hooks",
    "credentials",
    "leak"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skymeapple/AI-agents.git",
    "directory": "projects/agent-commit-guard"
  },
  "homepage": "https://github.com/Skymeapple/AI-agents/tree/research-lab/projects/agent-commit-guard#readme",
  "bugs": "https://github.com/Skymeapple/AI-agents/issues",
