{
  "name": "agentscrub",
  "version": "0.1.0",
  "description": "Find and remove secrets that AI coding agents save to disk: Claude Code \"don't ask again\" allowlists (.claude/settings.local.json), MCP configs, session transcripts. Hook + pre-commit guard.",
