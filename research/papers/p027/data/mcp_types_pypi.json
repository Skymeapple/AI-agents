{"info": {"author": "Model Context Protocol a Series of LF Projects, LLC.", "author_email": null, "bugtrack_url": null, "classifiers": ["Development Status :: 5 - Production/Stable", "Intended Audience :: Developers", "License :: OSI Approved :: MIT License", "Programming Language :: Python :: 3", "Programming Language :: Python :: 3.10", "Programming Language :: Python :: 3.11", "Programming Language :: Python :: 3.12", "Programming Language :: Python :: 3.13", "Programming Language :: Python :: 3.14"], "description": "# MCP Types\n\nThe wire types for the [Model Context Protocol](https://modelcontextprotocol.io).\n\nThis package holds the protocol message models, JSON-RPC envelope types, per-version\nsurface validators, and the protocol-version registry. Its only runtime dependencies are\n`pydantic` and `typing-extensions`, so it can be installed on its own when you need to\n(de)serialize MCP traffic without pulling in the full `mcp` SDK.\n\n```python\nfrom mcp_types import Tool, CallToolRequest\nfrom mcp_types.version import LATEST_PROTOCOL_VERSION\n```\n\nThe `mcp` package re-exports these names, so existing `from mcp import Tool` imports\nkeep working.\n", "description_content_type": "text/markdown", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": null, "keywords": "automation, llm, mcp", "license": "MIT", "license_expression": null, "license_files": ["LICENSE"], "maintainer": null, "maintainer_email": "David Soria Parra <davidsp@anthropic.com>, Marcelo Trylesinski <marcelotryle@gmail.com>, Max Isbey <maxisbey@anthropic.com>, Felix Weinberger <fweinberger@anthropic.com>", "name": "mcp-types", "package_url": "https://pypi.org/project/mcp-types/", "platform": null, "project_url": "https://pypi.org/project/mcp-types/", "project_urls": {"Documentation": "https://py.sdk.modelcontextprotocol.io/", "Homepage": "https://modelcontextprotocol.io", "Issues": "https://github.com/modelcontextprotocol/python-sdk/issues", "Repository": "https://github.com/modelcontextprotocol/python-sdk"}, "provides_extra": null, "release_url": "https://pypi.org/project/mcp-types/2.3.0/", "requires_dist": ["pydantic>=2.12.0", "typing-extensions>=4.13.0"], "requires_python": ">=3.10", "summary": "Model Context Protocol wire types", "version": "2.3.0", "yanked": false, "yanked_reason": null}, "last_serial": 41751580, "ownership": {"organization": null, "roles": [{"role": "Owner", "user": "Kludex"}, {"role": "Owner", "user": "dsp"}, {"role": "Owner", "user": "maxisbey"}]}, "releases": {"0.0.1": [{"comment_text": null, "core-metadata": {"sha256": "fd31b1ed9f6c4cfbfa89636433355e21def5df3537393e7c3d3c6a9e9169853a"}, "digests": {"blake2b_256": "803c0cd93be13e479f41644a69f80e2f8e1d73a3d5b624e1cfa594e800b57c66", "md5": "a42175d995264d05f99e7e96140d1ef2", "sha256": "24f7c2b16f19216c1847eb9b03b0c78ccea60d8ed8a43e117a263e4a84349222"}, "downloads": -1, "filename": "mcp_types-0.0.1-py3-none-any.whl", "has_sig": false, "md5_digest": "a42175d995264d05f99e7e96140d1ef2", "packagetype": "bdist_wheel", "python_version": "py3", "requires_python": ">=3.13", "size": 8319, "upload_time": "2025-06-21T09:00:18", "upload_time_iso_8601": "2025-06-21T09:00:18.552585Z", "url": "https://files.pythonhosted.org/packages/80/3c/0cd93be13e479f41644a69f80e2f8e1d73a3d5b624e1cfa594e800b57c66/mcp_types-0.0.1-py3-none-any.whl", "yanked": false, "yanked_reason": null}, {"comment_text": null, "core-metadata": false, "digests": {"blake2b_256": "0fab4acafe51796902730b129f1a2a0afaa4d494dfca1e31395de7381903a194", "md5": "4c3a5ce47fced215de5e591a1808ea95", "sha256": "83601f62c99834b9908cec4c4b805dee8a65d5842e35f234fa74cc528c10716c"}, "downloads": -1, "filename": "mcp_types-0.0.1.tar.gz", "has_sig": false, "md5_digest": "4c3a5ce47fced215de5e591a1808ea95", "packagetype": "sdist", "python_version": "source", "requires_python": ">=3.13", "size": 24221, "upload_time": "2025-06-21T09:00:19", "upload_time_iso_8601": "202